# Chat App

หน้าแชทแบบ Messenger (ไฟล์เดียว `index.html`) มีรายชื่อเพื่อน ปุ่มเพิ่มเพื่อน และปุ่ม AI chat

## วิธีใช้
เปิด `index.html` ในเบราว์เซอร์ได้เลย ไม่ต้องติดตั้งอะไร

## หมายเหตุ
- ข้อมูลเพื่อนและข้อความเก็บใน localStorage ของเบราว์เซอร์
- ยังไม่มีเซิร์ฟเวอร์ ข้อความหาเพื่อนจึงเห็นเฉพาะในเครื่องตัวเอง
- ต่อ AI จริงได้ที่ฟังก์ชัน `getAiReply` ใน `index.html`

## ขึ้น GitHub Pages
Settings > Pages > Branch: main > Save

<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eef2f4; --panel:#fff; --line:#cfd8dd; --ink:#1d2b33; --muted:#5d6f79;
  --accent:#0f6e7a; --accent-ink:#fff; --stage:#f6f9fa; --bubble:#e3eaee; --hover:#eef2f4;
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#141c20; --panel:#1c272d; --line:#33444c; --ink:#e6eef1; --muted:#93a6af;
         --accent:#4cc3d1; --accent-ink:#0d1a1e; --stage:#10181b; --bubble:#27363d; --hover:#141c20; }
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:"IBM Plex Sans Thai",system-ui,sans-serif;background:var(--bg);color:var(--ink)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
button,input,textarea{font:inherit;color:inherit}

.app{display:grid;grid-template-columns:280px 1fr;height:100%;gap:16px;padding:16px}

/* Sidebar */
.sidebar{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:8px;min-height:0}
.side-head{display:flex;justify-content:space-between;align-items:center;padding:2px 4px 6px}
.side-head h1{font-size:1.05rem;margin:0;font-weight:600}
.add-btn{cursor:pointer;border:0;background:var(--accent);color:var(--accent-ink);font-weight:500;padding:7px 12px;border-radius:8px}
.search{border:1px solid var(--line);background:var(--bg);border-radius:8px;padding:8px 10px;width:100%}
.list{display:flex;flex-direction:column;gap:2px;overflow-y:auto;min-height:0}
.friend{all:unset;box-sizing:border-box;cursor:pointer;display:flex;gap:10px;align-items:center;padding:8px;border-radius:8px}
.friend:hover{background:var(--hover)}
.friend[aria-current="true"]{background:var(--hover);box-shadow:inset 3px 0 0 var(--accent)}
.friend:focus-visible{outline:3px solid var(--accent)}
.avatar{flex:none;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:600;color:#fff}
.finfo{min-width:0}
.fname{font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fprev{font-size:.82rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.empty{color:var(--muted);font-size:.9rem;padding:12px 8px}

/* Main */
.main{display:grid;grid-template-rows:auto 1fr auto;gap:12px;min-height:0}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px}
.who{display:flex;align-items:center;gap:10px;font-weight:600;min-width:0}
.ai-btn{cursor:pointer;border:1px solid var(--line);background:var(--panel);padding:8px 18px;border-radius:8px;font-weight:600}
.ai-btn[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

.messages{background:var(--stage);border:1px solid var(--line);border-radius:10px;padding:16px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;min-height:0}
.msg{padding:10px 14px;border-radius:14px;max-width:min(75%,65ch);white-space:pre-wrap;line-height:1.5;overflow-wrap:anywhere}
.msg.me{align-self:flex-end;background:var(--accent);color:var(--accent-ink)}
.msg.them{align-self:flex-start;background:var(--bubble)}
.hint{margin:auto;color:var(--muted);text-align:center}

.composer{display:flex;gap:10px;align-items:flex-end;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px}
.composer textarea{flex:1;resize:none;background:transparent;border:0;outline:0;padding:6px;max-height:140px;line-height:1.5}
.composer button{cursor:pointer;border:0;border-radius:8px;padding:10px 20px;background:var(--accent);color:var(--accent-ink);font-weight:500}

/* Dialog */
dialog{border:1px solid var(--line);border-radius:12px;background:var(--panel);color:var(--ink);padding:20px;width:min(360px,92vw)}
dialog::backdrop{background:rgba(0,0,0,.4)}
dialog h2{margin:0 0 12px;font-size:1.05rem}
dialog label{display:block;font-size:.9rem;color:var(--muted);margin-bottom:6px}
dialog input{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
.dlg-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
.dlg-actions button{cursor:pointer;border-radius:8px;padding:8px 16px;border:1px solid var(--line);background:transparent}
.dlg-actions .ok{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:500}
.err{color:#c0392b;font-size:.85rem;min-height:1.2em;margin-top:6px}

@media (max-width:720px){
  .app{grid-template-columns:1fr;grid-template-rows:auto 1fr;padding:10px;gap:10px}
  .sidebar{max-height:38vh}
  .msg{max-width:90%}
}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar" aria-label="รายชื่อเพื่อน">
    <div class="side-head">
      <h1>แชท</h1>
      <button class="add-btn" id="add-btn">+ เพิ่มเพื่อน</button>
    </div>
    <input class="search" id="search" type="search" placeholder="ค้นหาเพื่อน" aria-label="ค้นหาเพื่อน">
    <div class="list" id="list"></div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="who" id="who"></div>
      <button class="ai-btn" id="ai-btn" aria-pressed="false">AI chat</button>
    </header>
    <section class="messages" id="messages" aria-live="polite"></section>
    <form class="composer" id="form">
      <textarea id="input" rows="1" placeholder="พิมพ์ข้อความ แล้วกด Enter เพื่อส่ง" aria-label="ข้อความ"></textarea>
      <button type="submit">ส่ง</button>
    </form>
  </main>
</div>

<dialog id="dlg">
  <form method="dialog" id="dlg-form">
    <h2>เพิ่มเพื่อน</h2>
    <label for="fname-in">ชื่อเพื่อน</label>
    <input id="fname-in" type="text" maxlength="40" autocomplete="off">
    <div class="err" id="err" role="alert"></div>
    <div class="dlg-actions">
      <button type="button" id="cancel">ยกเลิก</button>
      <button type="submit" class="ok">เพิ่ม</button>
    </div>
  </form>
</dialog>

<script>
const AI_ID = 'ai';
const COLORS = ['#0f6e7a','#8a5a9e','#b5651d','#3d7a3d','#a33b55','#3b5ba3'];
const $ = id => document.getElementById(id);

// ===== ข้อมูล: เก็บใน localStorage (ถ้าใช้ไม่ได้ก็เก็บในหน่วยความจำ) =====
const KEY = 'chat-app-v1';
function load(){
  try { const d = JSON.parse(localStorage.getItem(KEY)); if (d && d.friends) return d; } catch(e){}
  return { friends: [], msgs: { [AI_ID]: [{from:'them', text:'สวัสดี มีอะไรให้ช่วยไหม'}] }, current: null };
}
function save(){ try { localStorage.setItem(KEY, JSON.stringify(state)); } catch(e){} }
let state = load();

const nameOf = id => id === AI_ID ? 'AI chat' : (state.friends.find(f => f.id === id) || {}).name || '';
const colorOf = id => id === AI_ID ? '#444' : (state.friends.find(f => f.id === id) || {}).color;

function avatar(id){
  const a = document.createElement('div');
  a.className = 'avatar';
  a.style.background = colorOf(id);
  a.textContent = id === AI_ID ? 'AI' : nameOf(id).trim().charAt(0).toUpperCase();
  return a;
}

function render(){
  // รายชื่อเพื่อน
  const q = $('search').value.trim().toLowerCase();
  const list = $('list'); list.innerHTML = '';
  const shown = state.friends.filter(f => f.name.toLowerCase().includes(q));
  if (!state.friends.length){
    list.innerHTML = '<div class="empty">ยังไม่มีเพื่อน กด "+ เพิ่มเพื่อน" เพื่อเริ่มต้น</div>';
  } else if (!shown.length){
    list.innerHTML = '<div class="empty">ไม่พบเพื่อนที่ค้นหา</div>';
  }
  shown.forEach(f => {
    const b = document.createElement('button');
    b.className = 'friend';
    if (f.id === state.current) b.setAttribute('aria-current','true');
    const info = document.createElement('div'); info.className = 'finfo';
    const last = (state.msgs[f.id] || []).slice(-1)[0];
    info.innerHTML = '<div class="fname"></div><div class="fprev"></div>';
    info.children[0].textContent = f.name;
    info.children[1].textContent = last ? last.text : 'ยังไม่มีข้อความ';
    b.append(avatar(f.id), info);
    b.onclick = () => { state.current = f.id; save(); render(); $('input').focus(); };
    list.appendChild(b);
  });

  // หัวแชท
  const id = state.current;
  $('ai-btn').setAttribute('aria-pressed', id === AI_ID);
  const who = $('who'); who.innerHTML = '';
  if (id){ who.append(avatar(id), Object.assign(document.createElement('span'), {textContent: nameOf(id)})); }

  // ข้อความ
  const box = $('messages'); box.innerHTML = '';
  if (!id){
    box.innerHTML = '<div class="hint">เลือกเพื่อนทางซ้ายเพื่อเริ่มแชท<br>หรือกด AI chat เพื่อคุยกับ AI</div>';
  } else {
    const ms = state.msgs[id] || [];
    if (!ms.length) box.innerHTML = '<div class="hint">ยังไม่มีข้อความ ลองทักทายดู</div>';
    ms.forEach(m => {
      const d = document.createElement('div');
      d.className = 'msg ' + m.from; d.textContent = m.text; box.appendChild(d);
    });
    box.scrollTop = box.scrollHeight;
  }
  $('input').disabled = !id;
}

// ===== ตรงนี้คือจุดต่อ AI จริง =====
async function getAiReply(text){
  await new Promise(r => setTimeout(r, 500));
  return '(ยังไม่ได้เชื่อมต่อ AI) คุณพิมพ์ว่า: ' + text;
}

async function send(){
  const id = state.current, input = $('input');
  const text = input.value.trim();
  if (!id || !text) return;
  (state.msgs[id] = state.msgs[id] || []).push({from:'me', text});
  input.value = ''; input.style.height = 'auto';
  save(); render();
  if (id === AI_ID){
    const reply = await getAiReply(text);
    state.msgs[AI_ID].push({from:'them', text: reply});
    save(); render();
  }
  // แชทกับเพื่อน: ยังไม่มีเซิร์ฟเวอร์ ข้อความจึงเก็บไว้ในเครื่องนี้เท่านั้น
}

// ===== เพิ่มเพื่อน =====
const dlg = $('dlg');
$('add-btn').onclick = () => { $('fname-in').value = ''; $('err').textContent = ''; dlg.showModal(); $('fname-in').focus(); };
$('cancel').onclick = () => dlg.close();
$('dlg-form').addEventListener('submit', e => {
  const name = $('fname-in').value.trim();
  if (!name){ e.preventDefault(); $('err').textContent = 'กรุณาใส่ชื่อเพื่อน'; return; }
  if (state.friends.some(f => f.name.toLowerCase() === name.toLowerCase())){
    e.preventDefault(); $('err').textContent = 'มีเพื่อนชื่อนี้อยู่แล้ว'; return;
  }
  const f = { id: 'f' + Date.now(), name, color: COLORS[state.friends.length % COLORS.length] };
  state.friends.push(f); state.msgs[f.id] = []; state.current = f.id;
  save(); render();
});

$('ai-btn').onclick = () => { state.current = AI_ID; save(); render(); $('input').focus(); };
$('search').addEventListener('input', render);
$('form').addEventListener('submit', e => { e.preventDefault(); send(); });
$('input').addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey && !e.isComposing){ e.preventDefault(); send(); }
});
$('input').addEventListener('input', e => {
  const t = e.target; t.style.height = 'auto'; t.style.height = Math.min(t.scrollHeight, 140) + 'px';
});

render();
</script>
</body>
